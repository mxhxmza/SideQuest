# --- Routing / geocoding (OneMap, free account: https://www.onemap.gov.sg/apidocs/) ---
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Fallback routing (OpenRouteService free key, no transit) ---
ORS_API_KEY=

# --- NL parsing backend: rules | ollama | openai_compat ---
LLM_BACKEND=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Any OpenAI-compatible free tier (e.g. Groq, Gemini OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- App ---
REGION=singapore
POI_DB_PATH=data/pois.sqlite
CACHE_DB_PATH=data/cache.sqlite
CORS_ORIGINS=http://localhost:5173
